  m_Script: {fileID: 11500000, guid: ad9a31e7a2b00fb41921b390cac05242, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  entries:
  - key: 
    russian: 
    english: 
  - key: OpenCreatePanelButton
    russian: "\u0441\u043E\u0437\u0434\u0430\u0442\u044C \u0441\u0442\u043E\u043B"
    english: Create table
  - key: SettingsButton
    russian: "\u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
    english: Settings
  - key: BackButton
    russian: "\u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438"
    english: Back to registration
  - key: CreateTitle
    russian: "\u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0441\u0442\u043E\u043B\u0430"
    english: Table settings
  - key: CreateAndPlayButton
    russian: "\u0441\u043E\u0437\u0434\u0430\u0442\u044C \u0438 \u0438\u0433\u0440\u0430\u0442\u044C"
    english: Create & play
  - key: CancelCreateButton
    russian: "\u043D\u0430\u0437\u0430\u0434"
    english: Back
  - key: SettingsTitle
    russian: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
    english: Settings
  - key: MasterVolumeSlider
    russian: "\u0433\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u044C"
    english: Volume
  - key: BrightnessSlider
    russian: "\u044F\u0440\u043A\u043E\u0441\u0442\u044C"
    english: Brightness
  - key: LanguageDropdown
    russian: "\u044F\u0437\u044B\u043A"
    english: Language
  - key: CardThemeDropdown
    russian: "\u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u0435 \u043A\u0430\u0440\u0442"
    english: Card theme
  - key: ApplySettingsButton
    russian: "\u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C"
    english: Apply
  - key: CloseSettingsButton
    russian: "\u0437\u0430\u043A\u0440\u044B\u0442\u044C"
    english: Close
  - key: UserSettingsButton
    russian: "\u043F\u0440\u043E\u0444\u0438\u043B\u044C"
    english: Profile
  - key: UserSettingsTitle
    russian: "\u041F\u0440\u043E\u0444\u0438\u043B\u044C \u0438\u0433\u0440\u043E\u043A\u0430"
    english: Player profile
  - key: ChangeAvatarButton
    russian: "\u0441\u043C\u0435\u043D\u0438\u0442\u044C \u0430\u0432\u0430\u0442\u0430\u0440"
    english: Change avatar
  - key: ResetAvatarButton
    russian: "\u0441\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0430\u0432\u0430\u0442\u0430\u0440"
    english: Reset avatar
  - key: SaveUserSettingsButton
    russian: "\u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C"
    english: Save
  - key: CancelUserSettingsButton
    russian: "\u043E\u0442\u043C\u0435\u043D\u0430"
    english: Cancel
  - key: FriendsButton
    russian: "\u0434\u0440\u0443\u0437\u044C\u044F"
    english: Friends
  - key: MessagesButton
    russian: "\u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u044F"
    english: Messages
  - key: FriendsTitle
    russian: "\u0414\u0440\u0443\u0437\u044C\u044F"
    english: Friends
  - key: AddFriendButton
    russian: "\u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C"
    english: Add
  - key: CloseFriendsButton
    russian: "\u0437\u0430\u043A\u0440\u044B\u0442\u044C"
    english: Close
  - key: RequestsTitle
    russian: "\u0417\u0430\u044F\u0432\u043A\u0438 \u0432 \u0434\u0440\u0443\u0437\u044C\u044F"
    english: Friend requests
  - key: IncomingLabel
    russian: "\u0412\u0445\u043E\u0434\u044F\u0449\u0438\u0435 \u0437\u0430\u044F\u0432\u043A\u0438"
    english: Incoming
  - key: OutgoingLabel
    russian: "\u041E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0435
      \u0437\u0430\u044F\u0432\u043A\u0438"
    english: Outgoing
  - key: CloseRequestsButton
    russian: "\u0437\u0430\u043A\u0440\u044B\u0442\u044C"
    english: Close
  - key: AcceptButton
    russian: "\u043F\u0440\u0438\u043D\u044F\u0442\u044C"
    english: Accept
  - key: DeclineButton
    russian: "\u043E\u0442\u043A\u043B\u043E\u043D\u0438\u0442\u044C"
    english: Decline
  - key: CancelButton
    russian: "\u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C"
    english: Cancel
  - key: LeaderboardButton
    russian: "\u0442\u0430\u0431\u043B\u0438\u0446\u0430 \u043B\u0438\u0434\u0435\u0440\u043E\u0432"
    english: Leaderboard
  - key: RulesButton
    russian: "\u043F\u0440\u0430\u0432\u0438\u043B\u0430"
    english: Rules
  - key: ExitButton
    russian: "\u0432\u044B\u0439\u0442\u0438 \u0438\u0437 \u0438\u0433\u0440\u044B"
    english: Exit game
  matchByParentIfChild: 1
